#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

[ -f supabase/.env ] && { set -a; . supabase/.env; set +a; }
sb() { npx --yes supabase "$@"; }

remote() {
  : "${SUPABASE_PROJECT_REF:?Missing SUPABASE_PROJECT_REF in supabase/.env}"
  : "${SUPABASE_ACCESS_TOKEN:?Missing SUPABASE_ACCESS_TOKEN in supabase/.env}"
  : "${SUPABASE_DB_PASSWORD:?Missing SUPABASE_DB_PASSWORD in supabase/.env}"
  [ "$(cat supabase/.temp/project-ref 2>/dev/null)" = "$SUPABASE_PROJECT_REF" ] ||
    sb link --project-ref "$SUPABASE_PROJECT_REF" -p "$SUPABASE_DB_PASSWORD"
}

case "${1:-}" in
  new)     sb migration new "${2:?Usage: supabase/db new <migration_name>}" ;;
  test)    sb start && sb db reset && sb test db ;;
  status)  remote && sb migration list --linked -p "$SUPABASE_DB_PASSWORD" ;;
  migrate) remote && sb db push --linked --dry-run -p "$SUPABASE_DB_PASSWORD" &&
           sb db push --linked --yes -p "$SUPABASE_DB_PASSWORD" ;;
  *)       echo "Usage: supabase/db <new NAME|test|status|migrate>"; exit 1 ;;
esac
