#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

[ -f supabase/.env ] && { set -a; . supabase/.env; set +a; }
sb() { npx --yes supabase "$@"; }

remote() {
  : "${SUPABASE_PROJECT_REF:?Missing SUPABASE_PROJECT_REF in supabase/.env}"
  : "${SUPABASE_ACCESS_TOKEN:?Missing SUPABASE_ACCESS_TOKEN in supabase/.env}"
  : "${SUPABASE_DB_PASSWORD:?Missing SUPABASE_DB_PASSWORD in supabase/.env}"
  [ "$(cat supabase/.temp/project-ref 2>/dev/null)" = "$SUPABASE_PROJECT_REF" ] ||
    sb link --project-ref "$SUPABASE_PROJECT_REF" -p "$SUPABASE_DB_PASSWORD"
}

case "${1:-}" in
  new)     sb migration new "${2:?Usage: supabase/db new <migration_name>}" ;;
  test)    sb start && sb db reset && sb test db ;;
  load)    sb start && sb db reset &&
           psql_local() { docker exec -i supabase_db_daynest psql -q -U postgres -d postgres; } &&
           psql_local < supabase/load/seed.sql && psql_local < supabase/load/explain.sql &&
           eval "$(sb status -o env | grep -E '^(API_URL|ANON_KEY|JWT_SECRET)=' | sed 's/^/export /')" &&
           node supabase/load/run.mjs ;;
  status)  remote && sb migration list --linked -p "$SUPABASE_DB_PASSWORD" ;;
  migrate) remote && sb db push --linked --dry-run -p "$SUPABASE_DB_PASSWORD" &&
           sb db push --linked --yes -p "$SUPABASE_DB_PASSWORD" ;;
  functions)
           : "${GMAIL_USER:?Missing GMAIL_USER in supabase/.env}"
           : "${GMAIL_APP_PASSWORD:?Missing GMAIL_APP_PASSWORD in supabase/.env}"
           remote
           # Secrets go through a temp file, never the command line (ps) or the log.
           secrets=$(mktemp) && trap 'rm -f "$secrets"' EXIT
           printf 'GMAIL_USER=%s\nGMAIL_APP_PASSWORD=%s\n' "$GMAIL_USER" "$GMAIL_APP_PASSWORD" > "$secrets"
           sb secrets set --project-ref "$SUPABASE_PROJECT_REF" --env-file "$secrets" &&
           sb functions deploy send-bug-report --project-ref "$SUPABASE_PROJECT_REF" --use-api &&
           sb functions deploy delete-account --project-ref "$SUPABASE_PROJECT_REF" --use-api ;;
  function) remote && sb functions deploy "${2:?Usage: supabase/db function <name>}" --project-ref "$SUPABASE_PROJECT_REF" --use-api ;;
  *)       echo "Usage: supabase/db <new NAME|test|load|status|migrate|functions|function NAME>"; exit 1 ;;
esac
