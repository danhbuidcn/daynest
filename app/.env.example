# Copy thành app/.env (không commit) rồi điền.

# https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://xxfsqxuymswnbomxbpfs.supabase.co

# Supabase → Project Settings → API Keys → Publishable key
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Cloud → Google Auth Platform → Clients → client "Web" → Client ID
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Keystore release — bí mật quan trọng nhất (mất = không cập nhật được app; lộ = bị ký giả).
# Lưu cả file app/.env vào password manager. Máy mới: chép app/.env sang là build được.
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=daynest_alias
